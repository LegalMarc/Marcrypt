# General
.DS_Store
.AppleDouble
.LSOverride

# Directories to ignore
ignore-resources/

# Build artifacts (if ever generated in root)
build/
archive/

# Confidential document & archive types — never commit; may contain client or
# personal data. Real sample documents live under the git-ignored
# ignore-resources/ tree. A synthetic, non-confidential fixture (if ever needed)
# can be force-added with `git add -f` and must pass scripts/check_publishable.py.
*.pdf
*.doc
*.docx
*.dot
*.dotx
*.xls
*.xlsx
*.ppt
*.pptx
*.pages
*.numbers
*.key
*.rtf
*.odt
*.ods
*.odp
*.zip

# Signing / provisioning material — never commit.
*.p12
*.cer
*.mobileprovision
*.provisionprofile

# Xcode
DerivedData/
*.xcworkspace
*.xcuserdata
*.xccheckout
*.xcodeproj/project.xcworkspace/
*.xcodeproj/xcuserdata/

# Swift Package Manager
.build/
Packages/

# CocoaPods
Pods/

# Carthage
Carthage/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Archives
*.xcarchive

# Logs
*.log

# IDE Helpers
*.swp
*.swo
.idea/
*.orig

# Temporary files
*.tmp
*.bak

# Output bundles
*.ipa
*.app
*.dSYM.zip
*.dSYM

# Crash reports
*.crash

# Xcode Playgrounds
timeline.xctimeline
playground.xcworkspace

# Unit test coverage
*.gcda

# SwiftPM automatic indexing
.swiftpm/

# Secrets — match all variants
.env
.env.*
*.env
.env (1)
*.env.local
!.env.example

# Accidental local artifacts
.venv*/
test_output*/
._harness_output*/
build_log.txt
test_output.txt
dummy.pdf

# Editor-duplicated files (macOS Finder "file (1).ext" copies)
*\ (1)*

# macOS metadata
.DS_Store

# Python
__pycache__/
*.pyc

# Local agent/session config and worktrees (never publish)
.claude/
