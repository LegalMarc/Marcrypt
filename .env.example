# ============================================================
# Marcrypt build environment — EXAMPLE / TEMPLATE
#
# Copy this file to .env (which is git-ignored) and fill in
# your local values. NEVER store plaintext passwords here.
# ============================================================

# Apple Developer Team ID (from developer.apple.com)
TEAM_ID="QG85EMCQ75"

# Signing Identity — Developer ID certificate name for direct distribution
DEVELOPER_ID="Developer ID Application: Your Name (QG85EMCQ75)"

# Notarization — use a Keychain notarytool profile, NOT a plaintext password.
#
# One-time setup: store your Apple ID app-specific password in the Keychain:
#   xcrun notarytool store-credentials "marcrypt-notary-profile" \
#       --apple-id "your-apple-id@example.com" \
#       --team-id "QG85EMCQ75" \
#       --password "<app-specific-password-from-appleid.apple.com>"
#
# Then the build scripts reference the profile name only — no password on disk.
NOTARIZATION_PROFILE="marcrypt-notary-profile"

# App Store Connect API key (used by submit_appstore.sh — optional for direct dist)
# Generate at: App Store Connect → Users and Access → Integrations → App Store Connect API
# ASC_API_KEY_ID="XXXXXXXXXX"
# ASC_API_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# The corresponding .p8 private key must be placed in:
#   ~/.appstoreconnect/private_keys/AuthKey_<ASC_API_KEY_ID>.p8
